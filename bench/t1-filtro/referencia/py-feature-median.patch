+def median(values):
+    """Compute median of a non-empty list of numbers."""
+    s = sorted(values)
+    if not s:
+        raise ValueError("cannot compute median of empty list")
+    n = len(s)
+    mid = n // 2
+    if n % 2 == 1:
+        return s[mid]
+    return (s[mid - 1] + s[mid]) / 2.0
