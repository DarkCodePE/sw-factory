+export function isManagedBranch(branch: string, prefix = 'fab/'): boolean {
+  if (!branch || !branch.startsWith(prefix)) return false;
+  const suffix = branch.slice(prefix.length);
+  if (suffix.startsWith('_') && !suffix.startsWith('__')) return true;
+  return /^[A-Za-z0-9_-]+$/.test(suffix);
+}
+
 export const branchFor = (changeId: string): string => `fab/${changeId.slice(0, 8)}`;
 
